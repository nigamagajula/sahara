{
  "name": "sahara",
  "version": "1.0.0",
  "private": true,
  "description": "SAHARA — Mental Health Ecosystem",
  "scripts": {
    "dev": "npm --prefix server run dev & npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
